# Copy this file to .env.local and fill in what you need. None of these is required to run the app.

# Key for the texts a DeepSeek model writes from the results of each analysis (the reading at
# the top of the results, the recommendations and the questions). Without it those sections
# stay hidden and everything else works the same.
# Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Model used for the recommendations. Optional.
# DEEPSEEK_MODEL=deepseek-flash

# Public address of the site, used for the links between languages in the page metadata.
# On Vercel it is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Another server that speaks the Nominatim API, if you do not want to use openstreetmap.org.
# GEOCODER_URL=https://nominatim.openstreetmap.org

# Folder where analysis results are cached. Defaults to .cache/analysis (a temp folder on Vercel).
# ANALYSIS_CACHE_DIR=
